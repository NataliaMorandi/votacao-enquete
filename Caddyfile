# ------------------------------------------------------------------
# Caddy — termina o TLS e faz proxy reverso para os serviços internos.
#
#   /            -> votes-api:3000   (enquete)
#   /grafana/*   -> grafana:3000     (observabilidade)
#
# Domínio: enquete-cloud.duckdns.org -> EIP da EC2 (DNS no DuckDNS)
# Certificado Let's Encrypt automático, inclusive renovação.
# ------------------------------------------------------------------

enquete-cloud.duckdns.org {
	# logs em JSON para o CloudWatch (driver awslogs no compose)
	log {
		output stdout
		format json
	}

	# /grafana -> /grafana/ (o Grafana gera links com barra no final)
	redir /grafana /grafana/ 301

	handle /grafana/* {
		# NÃO usar "uri strip_prefix": com GF_SERVER_SERVE_FROM_SUB_PATH=true
		# o próprio Grafana espera receber /grafana/ e gera os links com o prefixo.
		reverse_proxy grafana:3000
	}

	# todo o resto vai para a API
	handle {
		reverse_proxy votes-api:3000
	}
}
