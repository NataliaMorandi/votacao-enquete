# Copie para .env e preencha (ou deixe o user_data.sh da EC2 gerar)

# --- Banco -------------------------------------------------------
POSTGRES_PASSWORD=troque-esta-senha

# --- Mensageria (preenchido pelo Terraform / console AWS) --------
AWS_REGION=us-east-1
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:votacao-enquetes-eventos
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/000000000000/votacao-tally-queue

# --- Token do endpoint interno chamado pela Lambda ---------------
INTERNAL_TOKEN=um-token-longo-e-aleatorio

# --- Grafana -----------------------------------------------------
GRAFANA_ADMIN_PASSWORD=admin123

# --- Para rodar LOCALMENTE sem AWS (opcional) --------------------
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_ENDPOINT_URL=http://localstack:4566
